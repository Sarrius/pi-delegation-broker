index 0000000..dca57da
--- /dev/null
+++ b/src/runner/trusted-launch-policy.ts
@@ -0,0 +1,281 @@
+import { createHash } from "node:crypto";
+import { accessSync, constants, lstatSync, readFileSync, realpathSync, statSync } from "node:fs";
+import { isAbsolute } from "node:path";
+import type { SubagentSpec, ThinkingLevel } from "../types.js";
+import { resolveModel, type ParentContext } from "./child.js";
+import { SHIM_SPEC_ENV } from "./subprocess/shim-contract.js";
+
+/**
+ * Controller-only child configuration. It deliberately has no provider/model,
+ * tool, cwd, prompt, or credential fields: a trusted resolver can allow a
+ * launch in an isolated Pi environment, but cannot silently change the task.
+ */
+export interface TrustedChildTerminalResult {
+  readonly status: "completed" | "failed" | "aborted";
+  readonly error?: string;
+}
+
+export interface TrustedExtensionSource {
+  /** Canonical source path used in the explicit --extension argument. */
+  readonly path: string;
+  /** SHA-256 of the reviewed extension bytes. */
+  readonly digest: string;
+}
+
+/** Controller-generated, parent-verified source-order commitment. */
+export interface TrustedLauncherAttestation {
+  readonly schemaVersion: 1;
+  readonly capabilityFingerprint: string;
+  readonly extensions: readonly TrustedExtensionSource[];
+  /** Must equal the final record in extensions. */
+  readonly behavioralExtension: TrustedExtensionSource;
+  readonly fingerprint: string;
+}
+
+export interface TrustedChildLaunchPolicy {
+  readonly policyId: string;
+  /** Existing, absolute, owner-only Pi agent dir selected by the controller. */
+  readonly agentDir: string;
+  /** Explicit extensions permitted in the otherwise discovery-free child. */
+  readonly extensionPaths?: readonly string[];
+  /** Optional controller-pinned source/order verification for explicit extensions. */
+  readonly launcherAttestation?: TrustedLauncherAttestation;
+  /** Tool names which must appear in the child startup report before handoff. */
+  readonly requiredActiveTools?: readonly string[];
+  /** Child-visible rules generated from the controller-bound capability. */
+  readonly promptRules?: string;
+  /** Disable Pi startup network operations for non-live/fake child runs. */
+  readonly offline?: boolean;
+  /**
+   * Parent-only handoff failure hook. It is never serialized into child argv,
+   * env, prompt, or shim spec. A broker uses it to release an unhanded lease
+   * when worktree/child construction fails before a ChildSession exists.
+   */
+  readonly onBeforeChildAbandoned?: (reason: "cancelled_before_child" | "child_construction_failed") => void | Promise<void>;
+  /** Parent-only handoff hook, after ChildSession construction succeeds. */
+  readonly onChildSessionOpened?: () => void | Promise<void>;
+  /** Parent-only completion hook, after ChildSession disposal/process exit. */
+  readonly onChildSessionClosed?: (result: TrustedChildTerminalResult) => void | Promise<void>;
+  /**
+   * Broker routing metadata and a short-lived lease-scoped capability. This
+   * must never carry a provider credential or controller/master capability.
+   */
+  readonly environment?: Readonly<Record<string, string>>;
+}
+
+/** Facts resolved before creating a worktree, shim file, or child process. */
+export interface TrustedChildLaunchRequest {
+  readonly childId: string;
+  /** SHA-256 only; raw prompt content is not copied into policy telemetry. */
+  readonly promptDigest: string;
+  readonly requestedCwd: string;
+  readonly isolation: "none" | "worktree";
+  readonly label?: string;
+  readonly schemaRequested: boolean;
+  readonly requestedTools?: readonly string[];
+  readonly excludedTools?: readonly string[];
+  readonly model: { readonly provider: string; readonly modelId: string; readonly thinkingLevel: ThinkingLevel };
+}
+
+export type TrustedChildLaunchDecision =
+  | { readonly action: "allow"; readonly policy: TrustedChildLaunchPolicy }
+  | { readonly action: "deny"; readonly reason: string };
+
+export type TrustedChildLaunchResolver =
+  (request: TrustedChildLaunchRequest) => Promise<TrustedChildLaunchDecision> | TrustedChildLaunchDecision;
+
+const ALLOWED_POLICY_ENVIRONMENT = new Set([
+  "PI_BROKER_SOCKET",
+  "PI_BROKER_LEASE_ID",
+  "PI_BROKER_FENCING_TOKEN",
+  "PI_BROKER_CAPABILITY",
+]);
+
+const SAFE_INHERITED_ENVIRONMENT = [
+  "PATH", "HOME", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL", "LC_CTYPE", "TERM", "COLORTERM", "NO_COLOR",
+  "SSL_CERT_FILE", "SSL_CERT_DIR",
+] as const;
+
+function readonlyList(values: readonly string[] | undefined): readonly string[] | undefined {
+  return values === undefined ? undefined : Object.freeze([...values]);
+}
+
+const SHA256 = /^[a-f0-9]{64}$/;
+const TOOL_NAME = /^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$/;
+
+function requireDigest(value: unknown, label: string): string {
+  if (typeof value !== "string" || !SHA256.test(value)) throw new Error(`${label} must be a SHA-256 hex digest`);
+  return value;
+}
+
+function boundedPromptRules(value: unknown): string | undefined {
+  if (value === undefined) return undefined;
+  if (typeof value !== "string" || value.length < 1 || value.length > 16_384 || value.includes("\0")) {
+    throw new Error("Trusted child launch policy promptRules must be 1..16384 characters without NUL");
+  }
+  return value;
+}
+
+function requiredTools(value: readonly string[] | undefined): readonly string[] | undefined {
+  if (value === undefined) return undefined;
+  if (!Array.isArray(value) || value.length < 1 || value.length > 128) {
+    throw new Error("Trusted child launch policy requiredActiveTools must contain 1..128 names");
+  }
+  if (value.some((name) => typeof name !== "string" || !TOOL_NAME.test(name)) || new Set(value).size !== value.length) {
+    throw new Error("Trusted child launch policy requiredActiveTools contains an invalid or duplicate tool name");
+  }
+  return Object.freeze([...value]);
+}
+
+function normalizeLauncherAttestation(value: TrustedLauncherAttestation | undefined, extensionPaths: readonly string[]): TrustedLauncherAttestation | undefined {
+  if (value === undefined) return undefined;
+  if (!value || typeof value !== "object" || value.schemaVersion !== 1 || !Array.isArray(value.extensions)) {
+    throw new Error("Trusted child launch policy launcherAttestation is malformed");
+  }
+  requireDigest(value.capabilityFingerprint, "Trusted launcher attestation capabilityFingerprint");
+  requireDigest(value.fingerprint, "Trusted launcher attestation fingerprint");
+  if (value.extensions.length !== extensionPaths.length || value.extensions.length < 1) {
+    throw new Error("Trusted launcher attestation extension count does not match explicit paths");
+  }
+  const extensions = value.extensions.map((entry, index) => {
+    if (!entry || typeof entry !== "object" || typeof entry.path !== "string" || typeof entry.digest !== "string") {
+      throw new Error("Trusted launcher attestation extension record is malformed");
+    }
+    if (entry.path !== extensionPaths[index]) throw new Error("Trusted launcher attestation extension order does not match explicit paths");
+    if (lstatSync(entry.path).isSymbolicLink()) throw new Error("Trusted launcher attestation extension must not be a symbolic link");
+    const actual = createHash("sha256").update(readFileSync(entry.path)).digest("hex");
+    if (actual !== requireDigest(entry.digest, "Trusted launcher attestation extension digest")) {
+      throw new Error("Trusted launcher attestation extension changed after approval");
+    }
+    return Object.freeze({ path: entry.path, digest: entry.digest });
+  });
+  const behavioral = value.behavioralExtension;
+  if (!behavioral || typeof behavioral.path !== "string" || typeof behavioral.digest !== "string") {
+    throw new Error("Trusted launcher attestation behavioralExtension is malformed");
+  }
+  const last = extensions.at(-1);
+  if (!last || behavioral.path !== last.path || behavioral.digest !== last.digest) {
+    throw new Error("Trusted launcher attestation requires behavioral extension final in explicit order");
+  }
+  return Object.freeze({
+    schemaVersion: 1,
+    capabilityFingerprint: value.capabilityFingerprint,
+    extensions: Object.freeze(extensions),
+    behavioralExtension: Object.freeze({ path: behavioral.path, digest: behavioral.digest }),
+    fingerprint: value.fingerprint,
+  });
+}
+
+/** Resolve and validate a controller decision before any child-side artifact exists. */
+export async function resolveTrustedChildLaunchPolicy(
+  resolver: TrustedChildLaunchResolver | undefined,
+  childId: string,
+  spec: SubagentSpec,
+  parent: ParentContext,
+): Promise<TrustedChildLaunchPolicy | undefined> {
+  if (!resolver) return undefined;
+  const { model, thinking } = resolveModel(spec, parent.ctx, parent.thinkingLevel);
+  const request: TrustedChildLaunchRequest = Object.freeze({
+    childId,
+    promptDigest: createHash("sha256").update(spec.prompt).digest("hex"),
+    requestedCwd: spec.cwd ?? parent.ctx.cwd,
+    isolation: spec.isolation ?? "none",
+    ...(spec.label === undefined ? {} : { label: spec.label }),
+    schemaRequested: spec.schema !== undefined,
+    ...(spec.tools === undefined ? {} : { requestedTools: readonlyList(spec.tools) }),
+    ...(spec.excludeTools === undefined ? {} : { excludedTools: readonlyList(spec.excludeTools) }),
+    model: Object.freeze({ provider: model.provider, modelId: model.id, thinkingLevel: thinking }),
+  });
+  const decision = await resolver(request);
+  if (decision.action === "deny") throw new Error(`Trusted child launch denied: ${decision.reason}`);
+  return normalizeTrustedChildLaunchPolicy(decision.policy);
+}
+
+/**
+ * Defensively copy and validate policy input. This runs both before worktree
+ * creation (via the resolver) and again just before subprocess spawn.
+ */
+export function normalizeTrustedChildLaunchPolicy(input: TrustedChildLaunchPolicy): TrustedChildLaunchPolicy {
+  if (!input || typeof input.policyId !== "string" || !input.policyId.trim() || input.policyId.includes("\0")) {
+    throw new Error("Trusted child launch policy must have a non-empty policyId");
+  }
+  if (typeof input.agentDir !== "string" || !isAbsolute(input.agentDir)) {
+    throw new Error("Trusted child launch policy agentDir must be an absolute path");
+  }
+  let agentDir: string;
+  try {
+    agentDir = realpathSync(input.agentDir);
+    const stat = statSync(agentDir);
+    accessSync(agentDir, constants.R_OK | constants.X_OK);
+    if (!stat.isDirectory()) throw new Error("path is not a directory");
+    // A broker child config can contain package/settings metadata and must not
+    // be writable/readable by another local account.
+    if ((stat.mode & 0o077) !== 0) throw new Error("directory permissions grant group or other access");
+  } catch (error) {
+    const detail = error instanceof Error ? error.message : String(error);
+    throw new Error(`Trusted child launch policy agentDir is not an owner-only usable directory: ${detail}`, { cause: error });
+  }
+
+  const extensionPaths = (input.extensionPaths ?? []).map((path) => {
+    if (typeof path !== "string" || !isAbsolute(path)) throw new Error("Trusted child launch policy extension path must be absolute");
+    try {
+      const resolved = realpathSync(path);
+      const stat = statSync(resolved);
+      accessSync(resolved, constants.R_OK);
+      if (!stat.isFile()) throw new Error("path is not a regular file");
+      return resolved;
+    } catch (error) {
+      const detail = error instanceof Error ? error.message : String(error);
+      throw new Error(`Trusted child launch policy extension is not a readable regular file: ${detail}`, { cause: error });
+    }
+  });
+
+  const launcherAttestation = normalizeLauncherAttestation(input.launcherAttestation, extensionPaths);
+  const activeToolRequirements = requiredTools(input.requiredActiveTools);
+  const promptRules = boundedPromptRules(input.promptRules);
+
+  const environment: Record<string, string> = {};
+  for (const [key, value] of Object.entries(input.environment ?? {})) {
+    if (!ALLOWED_POLICY_ENVIRONMENT.has(key)) throw new Error(`Trusted child launch policy cannot set environment variable ${key}`);
+    if (typeof value !== "string" || value.includes("\0")) throw new Error(`Trusted child launch policy environment ${key} is invalid`);
+    environment[key] = value;
+  }
+  if (input.offline !== undefined && typeof input.offline !== "boolean") {
+    throw new Error("Trusted child launch policy offline must be boolean when set");
+  }
+  if (input.onBeforeChildAbandoned !== undefined && typeof input.onBeforeChildAbandoned !== "function") {
+    throw new Error("Trusted child launch policy onBeforeChildAbandoned must be a function when set");
+  }
+  if (input.onChildSessionOpened !== undefined && typeof input.onChildSessionOpened !== "function") {
+    throw new Error("Trusted child launch policy onChildSessionOpened must be a function when set");
+  }
+  if (input.onChildSessionClosed !== undefined && typeof input.onChildSessionClosed !== "function") {
+    throw new Error("Trusted child launch policy onChildSessionClosed must be a function when set");
+  }
+  return Object.freeze({
+    policyId: input.policyId,
+    agentDir,
+    ...(input.offline ? { offline: true } : {}),
+    ...(input.onBeforeChildAbandoned ? { onBeforeChildAbandoned: input.onBeforeChildAbandoned } : {}),
+    ...(input.onChildSessionOpened ? { onChildSessionOpened: input.onChildSessionOpened } : {}),
+    ...(input.onChildSessionClosed ? { onChildSessionClosed: input.onChildSessionClosed } : {}),
+    ...(extensionPaths.length ? { extensionPaths: Object.freeze(extensionPaths) } : {}),
+    ...(launcherAttestation ? { launcherAttestation } : {}),
+    ...(activeToolRequirements ? { requiredActiveTools: activeToolRequirements } : {}),
+    ...(promptRules ? { promptRules } : {}),
+    ...(Object.keys(environment).length ? { environment: Object.freeze(environment) } : {}),
+  });
+}
+
+/** Build a deliberately small child environment; never spread parent process.env in brokered mode. */
+export function isolatedChildEnvironment(policy: TrustedChildLaunchPolicy, shimSpecPath: string): NodeJS.ProcessEnv {
+  const environment: NodeJS.ProcessEnv = {};
+  for (const key of SAFE_INHERITED_ENVIRONMENT) {
+    const value = process.env[key];
+    if (value !== undefined) environment[key] = value;
+  }
+  environment.PI_CODING_AGENT_DIR = policy.agentDir;
+  for (const [key, value] of Object.entries(policy.environment ?? {})) environment[key] = value;
+  environment[SHIM_SPEC_ENV] = shimSpecPath;
+  return environment;
+}
