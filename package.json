{
  "name": "@sars267/pi-delegation-broker",
  "version": "0.1.0-alpha.1",
  "description": "Non-production, single-host reference broker for capability-scoped Pi child delegation.",
  "type": "module",
  "main": "./src/index.mjs",
  "pi": {
    "extensions": [
      "./extensions/pi-delegation-broker.ts"
    ]
  },
  "exports": {
    ".": "./src/index.mjs",
    "./testing": "./src/testing.mjs"
  },
  "files": [
    "src",
    "extensions",
    "docs/INTEGRATION.md",
    "docs/LIVE-VALIDATION-PLAN.md",
    "docs/PROVIDER-PROXY-PROTOCOL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "check": "node --check src/*.mjs && node --check test/*.mjs && node scripts/check-public-tree.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "release:check": "npm run check && npm test && npm run pack:check",
    "prepublishOnly": "npm run release:check"
  },
  "keywords": [
    "pi",
    "agent",
    "delegation",
    "broker",
    "lease",
    "capability",
    "sqlite",
    "security"
  ],
  "license": "MIT",
  "author": "Vitalii Simko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarrius/pi-delegation-broker.git"
  },
  "bugs": {
    "url": "https://github.com/Sarrius/pi-delegation-broker/issues"
  },
  "homepage": "https://github.com/Sarrius/pi-delegation-broker#readme",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
